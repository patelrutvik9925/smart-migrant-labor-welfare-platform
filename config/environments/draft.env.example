# ============================================================
# DRAFT ENVIRONMENT CONFIGURATION
# Copy this file to draft.env and fill in real values.
# NEVER commit draft.env to version control.
# ============================================================

# --- IBM watsonx Orchestrate ---
WXO_URL=https://api.jp-tok.watson-orchestrate.cloud.ibm.com/instances/4a57643b-32dd-41ac-845f-73f4381e580e
WXO_API_KEY=your_ibm_cloud_api_key_here
WXO_ENVIRONMENT=draft

# --- IBM Cloud ---
IBM_CLOUD_REGION=jp-tok
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here

# --- Database (IBM Cloud Databases for PostgreSQL) ---
DB_HOST=your_postgres_host
DB_PORT=5432
DB_NAME=migrant_welfare_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL_MODE=require
DB_SSL_CERT_PATH=./config/certs/db-cert.pem

# --- IBM Cloud Object Storage ---
COS_ENDPOINT=your_cos_endpoint
COS_API_KEY=your_cos_api_key
COS_INSTANCE_CRN=your_cos_crn
COS_BUCKET_WORKER_DOCS=migrant-worker-docs-draft
COS_BUCKET_COMPLAINT_EVIDENCE=migrant-complaint-evidence-draft
COS_BUCKET_KNOWLEDGE=migrant-knowledge-base-draft

# --- Authentication / OTP ---
SMS_PROVIDER=your_sms_provider
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=MGRWLF
OTP_EXPIRY_SECONDS=300
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRY_HOURS=24

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
SECRET_KEY=your_flask_secret_key_min_32_chars

# --- Notifications ---
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_INAPP_ENABLED=true

# --- Logging ---
LOG_LEVEL=DEBUG
LOG_FILE=./logs/backend.log
AUDIT_LOG_FILE=./logs/audit.log

# --- Knowledge Base ---
KNOWLEDGE_UPDATE_SCHEDULE=0 2 * * *
KNOWLEDGE_HUMAN_REVIEW_REQUIRED=true

# --- Environment ---
ENVIRONMENT=draft
VERSION=1.0.0
