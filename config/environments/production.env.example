# ============================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to production.env and fill in real values.
# NEVER commit production.env to version control.
# ============================================================

# --- IBM watsonx Orchestrate ---
WXO_URL=https://api.jp-tok.watson-orchestrate.cloud.ibm.com/instances/4a57643b-32dd-41ac-845f-73f4381e580e
WXO_API_KEY=your_production_ibm_cloud_api_key
WXO_ENVIRONMENT=live

# --- IBM Cloud ---
IBM_CLOUD_REGION=jp-tok
IBM_CLOUD_API_KEY=your_production_ibm_cloud_api_key

# --- Database ---
DB_HOST=your_production_postgres_host
DB_PORT=5432
DB_NAME=migrant_welfare_db_prod
DB_USER=your_production_db_user
DB_PASSWORD=your_production_db_password
DB_SSL_MODE=require
DB_SSL_CERT_PATH=./config/certs/db-cert-prod.pem

# --- IBM Cloud Object Storage ---
COS_ENDPOINT=your_cos_endpoint
COS_API_KEY=your_cos_api_key
COS_INSTANCE_CRN=your_cos_crn
COS_BUCKET_WORKER_DOCS=migrant-worker-docs-prod
COS_BUCKET_COMPLAINT_EVIDENCE=migrant-complaint-evidence-prod
COS_BUCKET_KNOWLEDGE=migrant-knowledge-base-prod

# --- Authentication / OTP ---
SMS_API_KEY=your_production_sms_api_key
SMS_SENDER_ID=MGRWLF
OTP_EXPIRY_SECONDS=180
JWT_SECRET=your_production_jwt_secret_min_64_chars
JWT_EXPIRY_HOURS=12

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=false
ALLOWED_ORIGINS=https://your-production-domain.com

# --- Notifications ---
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_INAPP_ENABLED=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=/var/log/migrant-welfare/backend.log
AUDIT_LOG_FILE=/var/log/migrant-welfare/audit.log

# --- Knowledge Base ---
KNOWLEDGE_UPDATE_SCHEDULE=0 1 * * *
KNOWLEDGE_HUMAN_REVIEW_REQUIRED=true

# --- Environment ---
ENVIRONMENT=production
VERSION=1.0.0
